# Default to LF for all text files
* text=auto eol=lf

# Explicit LF for scripts and configs
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Windows-native files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.jpg binary
*.png binary
*.pth binary
*.jar binary